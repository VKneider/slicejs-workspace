{
  "$comment": "Manifest consumed by scripts/bootstrap.mjs, scripts/doctor.mjs and scripts/status.mjs. Keep remotes/branches in sync with .git/config of each checkout.",
  "reposDir": "repos",
  "repos": [
    {
      "dir": "slice.js",
      "name": "slice.js",
      "package": "slicejs-web-framework",
      "role": "framework",
      "remote": "https://github.com/vkneider/slice.js.git",
      "branch": "master",
      "required": true
    },
    {
      "dir": "slicejs-cli",
      "name": "slicejs-cli",
      "package": "slicejs-cli",
      "role": "cli",
      "remote": "https://github.com/vkneider/slicejs-cli.git",
      "branch": "master",
      "required": true
    },
    {
      "dir": "slicejs-components",
      "name": "slicejs-components",
      "package": "slicejs-components",
      "role": "components",
      "remote": "https://github.com/VKneider/slicejs-components.git",
      "branch": "master",
      "required": true
    },
    {
      "dir": "slicejs-mcp",
      "name": "slicejs-mcp",
      "package": "slicejs-mcp",
      "role": "mcp",
      "remote": "https://github.com/VKneider/slicejs-mcp.git",
      "branch": "master",
      "required": true
    },
    {
      "dir": "slice.js_docs",
      "name": "slice.js_docs",
      "package": "slicedocs",
      "role": "docs",
      "remote": "https://github.com/vkneider/slice.js_docs.git",
      "branch": "master",
      "required": false
    },
    {
      "dir": "conclave",
      "name": "conclave",
      "package": "teams-organizer",
      "role": "product",
      "remote": "https://github.com/vkneider/conclave.git",
      "branch": "master",
      "required": true
    },
    {
      "dir": "portfolio",
      "name": "portfolio",
      "package": "portfoliovk2",
      "role": "product",
      "remote": "https://github.com/VKneider/portfolio.git",
      "branch": "master",
      "required": false
    }
  ],
  "links": [
    {
      "package": "slicejs-web-framework",
      "dir": "slice.js"
    },
    {
      "package": "slicejs-cli",
      "dir": "slicejs-cli"
    }
  ],
  "consumers": [
    "conclave",
    "slicejs-components",
    "slice.js_docs",
    "slicejs-cli",
    "portfolio"
  ]
}
